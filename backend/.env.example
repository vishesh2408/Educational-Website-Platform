# Backend environment variables example
# Copy this file to .env and edit values as needed

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/eduDB

# Server port
PORT=3001

# JWT secret used to sign session cookies
JWT_SECRET=your_jwt_secret_here

# Duration (in minutes) for account lockouts before automatic unlock
ACCOUNT_LOCK_DURATION_MINUTES=4

# Email Configuration (for password reset, etc.)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# OpenAI API Key (for AI features)
OPENAI_API_KEY=your_openai_api_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend URL
BACKEND_URI=http://localhost:3001

# Razorpay API Credentials (Configure with your Razorpay dashboard keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (from Razorpay Dashboard → Settings → Webhooks)
# Required for verifying webhook signatures in production
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Gateway Webhook Secret (for third-party payment gateway integration)
GATEWAY_WEBHOOK_SECRET=your_gateway_webhook_secret_here

# JWT expiration duration (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN=30d

# Cookie maxAge in milliseconds (e.g., 2592000000 for 30 days)
COOKIE_MAX_AGE_MS=2592000000
